# Google Sheets ID
SPREADSHEET_ID=your_sheet_id_here

# Discord webhook URL
WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_here

# Google service account JSON (paste the full JSON as a single line)
# In Railway, set this as a raw environment variable
GOOGLE_CREDS_JSON={"type":"service_account",...}

# Optional: local credentials file (alternative to GOOGLE_CREDS_JSON)
GOOGLE_CREDS_FILE=credentials.json

# Loop interval in seconds (default 120)
LOOP_INTERVAL=120
